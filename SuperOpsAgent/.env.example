# Application
APP_NAME=SuperOpsAgent
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=18000

# DashScope
# Required for LLM and embedding requests.
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus Lite
MILVUS_LITE_PATH=./data/milvus.db
MILVUS_LITE_DB_NAME=default
MILVUS_TIMEOUT=10000

# RAG
RAG_TOP_K=5
RAG_MODEL=qwen-max
RAG_TEMPERATURE=0.1
RAG_MAX_TOKENS=1200
RAG_ENABLE_THINKING=false
RAG_CONTEXT_SUMMARY_MODEL=qwen3.5-flash
RAG_CONTEXT_SUMMARY_TRIGGER_MESSAGES=12
RAG_CONTEXT_SUMMARY_KEEP_MESSAGES=6
RAG_RECALL_SIZE=20
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_TIMEOUT=10
RAG_RERANK_WARMUP_ENABLED=true
RAG_RERANK_WARMUP_TIMEOUT=120
RAG_RRF_K=60
RAG_QUERY_REWRITE_ENABLED=true
# Leave empty to use the main RAG model.
RAG_QUERY_REWRITE_MODEL=
RAG_QUERY_REWRITE_HISTORY_ROUNDS=3
RAG_QUERY_REWRITE_TIMEOUT=5
RAG_QUERY_REWRITE_MAX_LENGTH=200
# Unified LLM resilience
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_MIN_INTERVAL=0
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_TIMEOUT=30
LLM_RETRY_BACKOFF=0.25
LLM_FALLBACK_MODEL=qwen3.6-flash

# Offline evaluation
EVAL_MODEL=qwen-max
EVAL_OUTPUT_DIR=eval/reports
EVAL_METRIC_TIMEOUT=90
EVAL_FAITHFULNESS_TIMEOUT=300
EVAL_FAITHFULNESS_STATEMENT_BATCH_SIZE=10
EVAL_ANSWER_CORRECTNESS_TIMEOUT=240
EVAL_METRIC_MAX_CONCURRENCY=2
EVAL_CLIENT_MAX_RETRIES=3

# Elasticsearch
ES_SCHEME=http
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=biz
ES_TIMEOUT=10
# Use ik_max_word / ik_smart only when the IK plugin is installed.
ES_ANALYZER=standard
ES_SEARCH_ANALYZER=standard
ES_REQUIRED=false

# Document chunking
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP services
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:18003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:18004/mcp
AIOPS_DEFAULT_SERVICE_NAME=data-sync-service
