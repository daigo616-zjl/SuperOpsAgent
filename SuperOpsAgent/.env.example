# Application
APP_NAME=SuperOpsAgent
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=18000

# DashScope
# Required for LLM and embedding requests.
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus Lite
MILVUS_LITE_PATH=./data/milvus.db
MILVUS_LITE_DB_NAME=default
MILVUS_TIMEOUT=10000
# Milvus Lite gRPC keepalive; disable idle pings to avoid too_many_pings.
MILVUS_GRPC_KEEPALIVE_TIME_MS=60000
MILVUS_GRPC_KEEPALIVE_TIMEOUT_MS=20000
MILVUS_GRPC_KEEPALIVE_PERMIT_WITHOUT_CALLS=false

# RAG
RAG_TOP_K=5
RAG_MODEL=qwen3.7-flash
RAG_TEMPERATURE=0.1
RAG_MAX_TOKENS=1200
RAG_ENABLE_THINKING=false
RAG_CONTEXT_SUMMARY_MODEL=qwen3.5-flash
RAG_CONTEXT_SUMMARY_TRIGGER_MESSAGES=12
RAG_CONTEXT_SUMMARY_KEEP_MESSAGES=6
RAG_RECALL_SIZE=20
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_TIMEOUT=10
RAG_RERANK_WARMUP_ENABLED=true
RAG_RERANK_WARMUP_TIMEOUT=120
RAG_RRF_K=60
RAG_QUERY_REWRITE_ENABLED=true
# Leave empty to use the main RAG model.
RAG_QUERY_REWRITE_MODEL=
RAG_QUERY_REWRITE_HISTORY_ROUNDS=3
RAG_QUERY_REWRITE_TIMEOUT=5
RAG_QUERY_REWRITE_MAX_LENGTH=200
# Unified LLM resilience
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_MIN_INTERVAL=0
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_TIMEOUT=30
LLM_RETRY_BACKOFF=0.25
LLM_FALLBACK_MODEL=qwen3.6-flash

# Offline evaluation
EVAL_MODEL=qwen3.7-flash
EVAL_OUTPUT_DIR=eval/reports
EVAL_METRIC_TIMEOUT=90
EVAL_FAITHFULNESS_TIMEOUT=360
EVAL_FAITHFULNESS_STATEMENT_BATCH_SIZE=10
EVAL_ANSWER_CORRECTNESS_TIMEOUT=300
EVAL_METRIC_MAX_CONCURRENCY=2
EVAL_CLIENT_MAX_RETRIES=3
EVAL_RECALL_K=20
EVAL_HIT_K=5

# Elasticsearch
ES_SCHEME=http
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=biz
ES_TIMEOUT=10
# Use ik_max_word / ik_smart only when the IK plugin is installed.
ES_ANALYZER=standard
ES_SEARCH_ANALYZER=standard
ES_REQUIRED=false

# PostgreSQL authoritative knowledge store and transactional Outbox
DATABASE_URL=postgresql+psycopg://superops:superops@localhost:5432/superops
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
INDEX_WORKER_POLL_SECONDS=1
INDEX_WORKER_LEASE_SECONDS=300
INDEX_WORKER_MAX_ATTEMPTS=8
INDEX_REPAIR_INTERVAL_SECONDS=300
INDEX_REPAIR_BATCH_SIZE=100

# Document chunking
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP services
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:18003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:18004/mcp
AIOPS_DEFAULT_SERVICE_NAME=data-sync-service

# AIOps multi-agent orchestration (star topology)
AIOPS_MAX_ROUNDS=6
AIOPS_MAX_INVOCATIONS=60
AIOPS_MAX_WALL_SECONDS=300
AIOPS_MIN_DISPATCH_WALL_SECONDS=90
AIOPS_INVESTIGATION_WALL_SECONDS=150
AIOPS_INVESTIGATOR_TIMEOUT=60
# Investigator LLM in-call retries; 0 avoids burning task budget on hang spells
AIOPS_INVESTIGATOR_LLM_RETRIES=0
# Role models; leave empty to fall back to RAG_MODEL
#AIOPS_HYPOTHESIZER_MODEL=
#AIOPS_INVESTIGATOR_MODEL=
#AIOPS_ADJUDICATOR_MODEL=
#AIOPS_REPORTER_MODEL=
